# Who may do what (Radicale's rights file: the first section that matches counts).
# R/r: read collections/items, W/w: write them. The address book is /token-ring/pbx/, and each
# phone's login has a copy in its own home (/<login>/pbx/), where CardDAV apps look.

# token-ring (the web page) keeps the book and its copies, and makes the logins' homes for them
[owner]
user: token-ring
collection: .*
permissions: RrWw

# Each phone's login reads its own copy
[phone-home]
user: .+
collection: {user}
permissions: R

[phone-book]
user: .+
collection: {user}/[^/]+
permissions: Rr

# Everyone signed in may look at the top level (for discovery)
[root]
user: .+
collection:
permissions: R
