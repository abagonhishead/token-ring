# Who may do what (Radicale's rights file: the first section that matches counts).
# R/r: read collections/items, W/w: write them. The address book is /phones/pbx/: in the phones'
# home, where CardDAV apps (Linphone among them) look for it.

# token-ring (the web page) keeps it, and makes the phones' home for it
[owner]
user: token-ring
collection: phones(/.*)?
permissions: RrWw

[owner-home]
user: token-ring
collection: token-ring
permissions: RW

# The phones read it
[phones-home]
user: phones
collection: phones
permissions: R

[phones-book]
user: phones
collection: phones/.+
permissions: Rr

# Everyone signed in may look at the top level (for discovery)
[root]
user: .+
collection:
permissions: R
