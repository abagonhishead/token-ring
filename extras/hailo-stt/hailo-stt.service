[Unit]
Description=Speech-to-text on the Hailo-10H (Whisper) for the token-ring bridge
After=network-online.target hailo-ollama.service
Wants=network-online.target

[Service]
# Set the user, and where hailo_stt.py is
User=hailo-stt
SupplementaryGroups=hailo-ollama
# HailoRT writes hailort.log to the working directory
LogsDirectory=hailo-stt
WorkingDirectory=/var/log/hailo-stt
ExecStart=/usr/bin/python3 -u /opt/hailo-stt/hailo_stt.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
