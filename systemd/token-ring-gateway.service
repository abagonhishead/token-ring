# The gateway as a systemd user service, for running it on the host beside Claude Code:
#   pipx install /path/to/token-ring   (or pip install --user)
#   cp systemd/token-ring-gateway.service ~/.config/systemd/user/
#   systemctl --user enable --now token-ring-gateway; loginctl enable-linger $USER
[Unit]
Description=token-ring gateway: phone access to the AI sessions on this machine

[Service]
# claude, tmux and token-ring must be on this PATH
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/token-ring-gateway
# Restarting the gateway mustn't kill phone conversations mid-task: they finish by themselves
KillMode=process
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
